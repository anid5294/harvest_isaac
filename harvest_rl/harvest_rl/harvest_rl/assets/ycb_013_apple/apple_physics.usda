#usda 1.0
(
    defaultPrim = "Apple"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Apple" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    prepend references = @./apple_visual.usda@
)
{
    over "Mesh" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding:physics = </Apple/PhysicsMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        uniform token physics:approximation = "convexHull"
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1.1
        float physics:restitution = 0
        float physics:staticFriction = 1.4
    }
}

