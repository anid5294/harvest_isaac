    def "Looks"
    {
        def Material "AppleSkin"
        {
            token outputs:surface.connect = </Apple/Looks/AppleSkin/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Apple/Looks/AppleSkin/Texture.outputs:rgb>
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./texture_map.png@
                float2 inputs:st.connect = </Apple/Looks/AppleSkin/StReader.outputs:result>
                color3f outputs:rgb
            }
        }
    }
}

